<Window x:Class="LojaPerfumesWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loja de Perfumes" Height="520" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,15">
            <TextBlock Text="Loja de Perfumes" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="Adicionar" Width="100" Height="35" DockPanel.Dock="Right" Click="Adicionar_Click"/>
        </DockPanel>

        <DataGrid x:Name="TabelaPerfumes"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Perfume" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="160"/>
                <DataGridTextColumn Header="Preço" Binding="{Binding Preco, StringFormat=C2}" Width="110"/>
                <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10">
            <Button Content="Editar" Width="90" Height="32" Margin="0,0,8,0" Click="Editar_Click"/>
            <Button Content="Excluir" Width="90" Height="32" Click="Excluir_Click"/>
        </StackPanel>
    </Grid>
</Window>

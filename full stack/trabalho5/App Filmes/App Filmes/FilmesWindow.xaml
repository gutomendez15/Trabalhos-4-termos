<Window x:Class="FilmesApp.FilmesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filmes" Height="640" Width="920" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="GridDados" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="Grid_SelectionChanged" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"/>
                <DataGridTextColumn Header="Ano" Binding="{Binding AnoLancamento}"/>
                <DataGridTextColumn Header="Duração (min)" Binding="{Binding DuracaoMinutos}"/>
                <DataGridTextColumn Header="Nota" Binding="{Binding Nota}"/>
                <DataGridTextColumn Header="Gênero" Binding="{Binding Genero.Nome}"/>
                <DataGridTextColumn Header="Diretor" Binding="{Binding Diretor.Nome}"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="1" Header="Dados do filme" Padding="6">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <Label Content="Título:"/>
                    <TextBox x:Name="TxtTitulo" Grid.Column="1" Grid.ColumnSpan="3" MaxLength="150"/>

                    <Label Grid.Row="1" Content="Ano:"/>
                    <TextBox x:Name="TxtAno" Grid.Row="1" Grid.Column="1"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="Duração (min):"/>
                    <TextBox x:Name="TxtDuracao" Grid.Row="1" Grid.Column="3"/>

                    <Label Grid.Row="2" Content="Gênero:"/>
                    <ComboBox x:Name="CbGenero" Grid.Row="2" Grid.Column="1"
                              DisplayMemberPath="Nome" SelectedValuePath="Id"/>
                    <Label Grid.Row="2" Grid.Column="2" Content="Diretor:"/>
                    <ComboBox x:Name="CbDiretor" Grid.Row="2" Grid.Column="3"
                              DisplayMemberPath="Nome" SelectedValuePath="Id"/>

                    <Label Grid.Row="3" Content="Nota (0-10):"/>
                    <TextBox x:Name="TxtNota" Grid.Row="3" Grid.Column="1"/>
                    <Label Grid.Row="3" Grid.Column="2" Content="Sinopse:"/>
                    <TextBox x:Name="TxtSinopse" Grid.Row="3" Grid.Column="3" MaxLength="500"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Novo" Style="{StaticResource Acao}" Click="Novo_Click"/>
                    <Button Content="Salvar" Style="{StaticResource Acao}" Click="Salvar_Click"/>
                    <Button Content="Excluir" Style="{StaticResource Acao}" Click="Excluir_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>

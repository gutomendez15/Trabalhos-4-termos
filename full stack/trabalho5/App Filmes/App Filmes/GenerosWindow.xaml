<Window x:Class="FilmesApp.GenerosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gêneros" Height="460" Width="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="GridDados" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="Grid_SelectionChanged" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="1" Header="Dados do gênero" Padding="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Nome:"/>
                    <TextBox x:Name="TxtNome" Width="300" MaxLength="50"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Novo" Style="{StaticResource Acao}" Click="Novo_Click"/>
                    <Button Content="Salvar" Style="{StaticResource Acao}" Click="Salvar_Click"/>
                    <Button Content="Excluir" Style="{StaticResource Acao}" Click="Excluir_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>

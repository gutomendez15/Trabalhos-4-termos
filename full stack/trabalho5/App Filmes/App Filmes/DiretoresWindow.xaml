<Window x:Class="FilmesApp.DiretoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diretores" Height="500" Width="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="GridDados" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="Grid_SelectionChanged" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Nacionalidade" Binding="{Binding Nacionalidade}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="1" Header="Dados do diretor" Padding="6">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Content="Nome:"/>
                    <TextBox x:Name="TxtNome" Grid.Column="1" MaxLength="100"/>
                    <Label Grid.Row="1" Content="Nacionalidade:"/>
                    <TextBox x:Name="TxtNacionalidade" Grid.Row="1" Grid.Column="1" MaxLength="60"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Novo" Style="{StaticResource Acao}" Click="Novo_Click"/>
                    <Button Content="Salvar" Style="{StaticResource Acao}" Click="Salvar_Click"/>
                    <Button Content="Excluir" Style="{StaticResource Acao}" Click="Excluir_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
